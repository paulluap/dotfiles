## In .zshrc and .bashrc:
#if [ -f "$HOME/.shrc" ]; then
#    source "$HOME/.shrc"
#fi

alias config='/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME'
config config --local status.showUntrackedFiles no

# Add binaries to PATH if they aren't added yet.
# To add more paths, append to the list below (works in bash and zsh).
_paths_to_prepend=(
    "$HOME/.local/bin"
    "$HOME/go/bin"
)
for _p in "${_paths_to_prepend[@]}"; do
    case ":${PATH}:" in
        *:"${_p}":*) ;;
        *) export PATH="${_p}:$PATH" ;;
    esac
done
unset _p _paths_to_prepend


# Init zoxide (smart cd) only if installed
if command -v zoxide &>/dev/null; then
    _zoxide_shell=bash
    [ -n "${ZSH_VERSION-}" ] && _zoxide_shell=zsh
    eval "$(zoxide init $_zoxide_shell)"
    unset _zoxide_shell
fi

export EDITOR=vim


alias encrypt='openssl aes256 -pbkdf2 -a -A'
alias decrypt='openssl aes256 -pbkdf2 -a -A -d'

alias agent='ln -s ~/.claude/CLAUDE.md AGENTS.md > /dev/null 2>&1; agent'

# Usage:
#   proxyEnv                 # export proxy into current shell (port 7897)
#   proxyEnv 8080            # export with custom port
#   proxyEnv myprogram ...   # run command with proxy env
#   proxyEnv 8080 cmd ...    # run command with custom port
function proxyEnv {
    local port=7897
    if [ "${1-}" -eq "${1-}" ] 2>/dev/null; then
        port=$1
        shift
    fi

    local _http_proxy="http://127.0.0.1:${port}"
    local _https_proxy="$_http_proxy"
    local _no_proxy
    case ",${no_proxy-}," in
        *,localhost,127.0.0.1,*) _no_proxy="${no_proxy}" ;;
        *) _no_proxy="localhost,127.0.0.1${no_proxy:+,$no_proxy}" ;;
    esac

    if [ $# -eq 0 ]; then
        export http_proxy="$_http_proxy"
        export https_proxy="$_https_proxy"
        export HTTP_PROXY="$_http_proxy"
        export HTTPS_PROXY="$_https_proxy"
        export no_proxy="$_no_proxy"
        export NO_PROXY="$_no_proxy"
        echo "http(s)_proxy=${http_proxy}, no_proxy=${no_proxy}"
        return 0
    fi

    http_proxy="$_http_proxy" \
    https_proxy="$_https_proxy" \
    HTTP_PROXY="$_http_proxy" \
    HTTPS_PROXY="$_https_proxy" \
    no_proxy="$_no_proxy" \
    NO_PROXY="$_no_proxy" \
    "$@"
}
